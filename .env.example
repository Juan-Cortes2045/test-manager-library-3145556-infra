# Copy to .env and replace every "change-me" value. Never commit .env (Article IX).

# --- Database (used by the db container and by the API) ---
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=change-me

# --- API (Laravel) ---
APP_ENV=local
APP_DEBUG=false
# Generate with: docker compose run --rm api php artisan key:generate --show
APP_KEY=
APP_TIMEZONE=UTC
JWT_SECRET=change-me-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
COVERS_DIR=storage/app/covers
CORS_ORIGIN=http://localhost:5173

# --- Host ports (optional) ---
DB_HOST_PORT=5432
API_HOST_PORT=8000
APP_HOST_PORT=5173
